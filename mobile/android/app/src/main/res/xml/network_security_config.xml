<?xml version="1.0" encoding="utf-8"?>
<!-- A widgetd server is often a box on the home network, reached over plain
     http (http://192.168.1.10:8080). Allow cleartext so the board loads. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
