    digest: b5:a4a2d4d808a25984cced60769c822c5d496ef0b740f56ac0c9e6b97aaa25b86a9332a00ffd74e0cd202be29e91bd3edfb0bf2ba4dacfe48ff2d8217f9986e3c8
</file>

<file path="localdep/index.ts">
export const tag = "multi-localdep";
</file>

<file path="localdep/package.json">
{
  "name": "localdep",
  "version": "1.0.0",
  "main": "index.ts"
}
</file>

<file path="proto/multi/common/v1/common.proto">
syntax = "proto3";

package multi.common.v1;

message Count {
  int32 n = 1;
}
</file>

<file path="server/next.go">
package server

// next is the count after n.
func next(n int32) int32 { return n + 1 }
</file>

<file path="server/next_test.go">
package server

import "testing"

func TestNext(t *testing.T) {
	if got := next(41); got != 42 {
		t.Fatalf("next(41) = %d", got)
	}
}
</file>

<file path="view/label.test.ts">
import { create } from "@bufbuild/protobuf";
import { expect, test } from "bun:test";
import { StateSchema } from "widget/schema";
import { label } from "./label.ts";

test("label", () => {
  expect(label(create(StateSchema, { count: { n: 3 } }))).toBe("count: 3 (multi-localdep)");
});
</file>

<file path="view/label.ts">
import { tag } from "localdep";
import type { State } from "widget/schema";

export function label(s: State): string {
  return `count: ${s.count?.n ?? 0} (${tag})`;
}
</file>

<file path="view/package.json">
{
  "name": "multi-view",
  "private": true,
  "dependencies": {
    "localdep": "file:../localdep"
  }
}
</file>

<file path="view/plugins.ts">
import type { BunPlugin } from "bun";

const tag: BunPlugin = {
  name: "multi-plugin",
  setup(build) {
    build.onResolve({ filter: /^virtual:multi-plugin$/ }, () => ({ path: "tag", namespace: "multi" }));
    build.onLoad({ filter: /.*/, namespace: "multi" }, () => ({ contents: 'export default " multi-plugin-ok";', loader: "js" }));
  },
};
export default [tag];
</file>
