<manifest>
name    = "multi"
version = "0.1.0"
title   = "Multi"
icon    = "layers"
config  = "multi.v1.Config"
# Everything a folder can have beyond the named blocks: more protos, more
# server files, more view modules, tests, the view's own package.json, and
# build plugins.
</manifest>

<schema>
syntax = "proto3";

package multi.v1;

import "multi/common/v1/common.proto";

message Config {
  string label = 1;
}

message State {
  multi.common.v1.Count count = 1;
}
</schema>

<server lang="go">
package server

import (
	"context"
	"time"

	common "widget/gen/multi/common/v1"
	pb "widget/schema"

	"github.com/aren55555/widgetd/sdk/go/widget"
)

// Run counts up once a second.
func Run(ctx context.Context, h widget.Host) error {
	var cfg pb.Config
	if err := h.Config(&cfg); err != nil {
		return err
	}
	card, err := widget.MountState[*pb.State](h, "count", widget.MountOptions{Title: cfg.GetLabel()})
	if err != nil {
		return err
	}
	for n := int32(0); ; n = next(n) {
		if err := card.Snapshot(&pb.State{Count: &common.Count{N: n}}); err != nil {
			return err
		}
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-time.After(time.Second):
		}
	}
}
</server>

<view lang="ts">
import { defineWidget } from "@widgetd/sdk";
import { StateSchema } from "widget/schema";
import { label } from "./label.ts";
// Supplied by view/plugins.ts.
import pluginTag from "virtual:multi-plugin";

defineWidget({
  state: StateSchema,
  mount({ root }) {
    return {
      update(s) {
        root.textContent = label(s) + pluginTag;
      },
    };
  },
});
</view>

<style>
body { font-family: system-ui, sans-serif; }
</style>

